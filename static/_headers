# Security headers (Cloudflare Workers static assets). The script/style/connect policy is
# a <meta> CSP generated by SvelteKit (svelte.config.js); these only work as headers.
/*
  Content-Security-Policy: frame-ancestors 'self' https://adsense.google.com https://www.google.com; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/spinny/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
