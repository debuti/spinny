{
	"name": "spinny",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Spin the wheel to pick between options: dinner, chores, who goes first.",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "wrangler dev --port 8788",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"idb-keyval": "6.3.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/fredoka": "5.3.0",
		"@fontsource-variable/nunito": "5.3.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@types/node": "22.18.6",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "16.4.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.1",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"wrangler": "4.148.0"
	}
}
